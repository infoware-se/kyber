<wassignedby><name>CN=Domino/O=Infoware</name></wassignedby><code event='library'
 for='web'><javascript>/**
 * Client JS starter (Default-ClientJs)
 */
function hello(name) {
	name = name || 'World';
	return 'Hello, ' + name + '!';
}

function setStatus(msg) {
	if (typeof window !== 'undefined' &amp;&amp; window.status !== undefined) {
		window.status = msg;
	}
	return msg;
}
</javascript></code></scriptlibrary>

