# Example — copy to .env / .env.drapi and fill in real values.
# Those files are gitignored and must never be committed.
# This Domino install uses HTTPS on the REST port.

DOMINO_REST_URL=https://your-host:8880
DOMINO_REST_USER=admin
DOMINO_REST_PASSWORD=secret

# Optional: database used for smoke tests
# DOMINO_NSF_PATH=testdb.nsf
