# Copy to .env in the repo root and fill in real values.
# .env is gitignored and must never be committed.
# Used by Kyber tools (smoke-kyber-api.ps1, export/import, restart-restapi-com.ps1).

DOMINO_REST_URL=https://your-host:8880
DOMINO_REST_API_DATA_URL=https://your-host:8880
DOMINO_SERVER=YourDominoServer
DOMINO_REST_USER=admin
DOMINO_REST_PASSWORD=secret
REST_ADMIN_USER=admin
REST_ADMIN_PASSWORD=secret

# Optional: NSF for smoke / export tools (defaults NSF for starters is kyber.nsf)
# DOMINO_NSF_PATH=testdb.nsf
