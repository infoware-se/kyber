<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE agent SYSTEM 'xmlschemas/domino_14_5_1.dtd'>
<agent name='Default-LotusScriptAgent' xmlns='http://www.lotus.com/dxl' version='14.5'
 maintenanceversion='1.0' hide='v3' publicaccess='false'
 designerversion='8.5.3'>




<trigger type='actionsmenu'/>
<documentset type='selected'/><code event='options'><lotusscript>%REM
	Agent newagentlotusscript
	Description: Standalone agent template - Options / Initialize / Terminate (no Use)
%END REM
Option Public
Option Declare

</lotusscript></code><code event='declarations'><lotusscript>%REM
	Declarations
	Description: Module-level variables for the agent run
%END REM

</lotusscript></code><code event='initialize'><lotusscript>%REM
	Sub Initialize
	Description: Entry point when the agent runs
%END REM
Sub Initialize
	Print "Hello World"
End Sub

</lotusscript></code><code event='terminate'><lotusscript>%REM
	Sub Terminate
	Description: Cleanup when the agent finishes
%END REM
Sub Terminate

End Sub</lotusscript></code></agent>
