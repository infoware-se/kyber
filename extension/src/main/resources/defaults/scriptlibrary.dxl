<wassignedby><name>CN=Domino/O=Infoware</name></wassignedby><code event='options'><lotusscript
>Option Public
Option Declare
</lotusscript></code><code event='FormatTitle'><lotusscript>Function Hello(Optional name As String = "World") As String
	Hello = "Hello, " &amp; name &amp; "!"
End Function

Function FormatTitle(title As String) As String
	If title = "" Then
		FormatTitle = "(untitled)"
	Else
		FormatTitle = Trim$(title)
	End If
End Function</lotusscript></code></scriptlibrary>

