<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE scriptlibrary SYSTEM 'xmlschemas/domino_14_5_1.dtd'>
<scriptlibrary name='Default-LotusScript' xmlns='http://www.lotus.com/dxl'
 version='14.5' maintenanceversion='1.0' hide='v3 v4strict'
 designerversion='8.5.3'>


<code event='options'><lotusscript
>%REM
	Library newscriptlibrarylotusscript
	Description: Example LotusScript library - Options, Class, Function, Sub
%END REM
Option Public
Option Declare

</lotusscript></code><code event='Hello'><lotusscript>%REM
	Function Hello
	Description: Convenience wrapper around Greeting
%END REM
Function Hello(who As String) As String
	If who = "" Then who = "World"
	Hello = "Hello, " &amp; who &amp; "!"
End Function

</lotusscript></code><code event='LogMessage'><lotusscript>%REM
	Sub LogMessage
	Description: Write a message to the status bar / console
%END REM
Sub LogMessage(msg As String)
	If msg = "" Then Exit Sub
	Print msg
End Sub</lotusscript></code></scriptlibrary>
