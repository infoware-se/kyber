<wassignedby><name>CN=Designer/O=Infoware</name></wassignedby><code event='options'><lotusscript
>%REM
	Library Default-LotusScript
	Description: Example LotusScript library - Options, Class, Function, Sub
%END REM
Option Public
Option Declare

</lotusscript></code><code event='declarations'><lotusscript>%REM
	Class Greeting
	Description: Simple class with constructor, destructor and a method
%END REM
Class Greeting
	Private m_who As String

	%REM
		Sub New
		Description: Create a greeting for who (default World)
	%END REM
	Sub New(who As String)
		If who = "" Then
			m_who = "World"
		Else
			m_who = who
		End If
	End Sub

	%REM
		Sub Delete
		Description: Cleanup
	%END REM
	Sub Delete
		m_who = ""
	End Sub

	%REM
		Function Text
		Description: Build greeting string
	%END REM
	Function Text As String
		Text = "Hello, " &amp; m_who &amp; "!"
	End Function
End Class
</lotusscript></code><code event='Hello'><lotusscript>%REM
	Function Hello
	Description: Convenience wrapper around Greeting
%END REM
Function Hello(who As String) As String
	Dim g As New Greeting(who)
	Hello = g.Text
End Function

</lotusscript></code><code event='LogMessage'><lotusscript>%REM
	Sub LogMessage
	Description: Write a message to the status bar / console
%END REM
Sub LogMessage(msg As String)
	If msg = "" Then Exit Sub
	Print "Default-LotusScript: " &amp; msg
End Sub

</lotusscript></code><code event='FormatTitle'><lotusscript>%REM
	Function FormatTitle
	Description: Normalize a title string
%END REM
Function FormatTitle(title As String) As String
	If title = "" Then
		FormatTitle = "(untitled)"
	Else
		FormatTitle = Trim$(title)
	End If
End Function
</lotusscript></code></scriptlibrary>

