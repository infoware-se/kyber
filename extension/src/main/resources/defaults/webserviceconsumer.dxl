<item name='$ScriptLib' summary='false' sign='true'><text>'++LotusScript Development Environment:2:5:(Options):0:66
Option Public

'++LotusScript Development Environment:2:5:(Forward):0:1
Declare Class DefaultProvider As PortTypeBase

'++LotusScript Development Environment:2:5:(Declarations):0:10
%INCLUDE "lsxsd.lss"
Class DefaultProvider As PortTypeBase
	
	Sub NEW
		Call Service.Initialize ("UrnDefaultNamespaceDefaultProviderService", _
		"DefaultProviderService.Domino", "http://localhost", _
		"DefaultProvider")
		
	End Sub
	
	Function HELLO(TXT As String) As String
		Let HELLO = Service.Invoke("HELLO", TXT)
	End Function
	
End Class
<break/></text></item>
