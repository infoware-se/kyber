<wassignedby><name>CN=Domino/O=Infoware</name></wassignedby><code event='options'><lotusscript
>%REM
	Database Script
	Description: Example Options + Postopen / Queryclose (no Option Public here)
%END REM
Option Declare
</lotusscript></code><code event='declarations'><lotusscript>%REM
	Declarations
	Description: Shared state for database UI events
%END REM
Dim g_openCount As Integer
</lotusscript></code><code event='postopen'><lotusscript>%REM
	Sub Postopen
	Description: Runs when the database is opened in the Notes client
%END REM
Sub Postopen(Source As Notesuidatabase)
	g_openCount = g_openCount + 1
	Print "Default Database Script - opened: " &amp; Source.Database.Title &amp; " (#" &amp; Cstr(g_openCount) &amp; ")"
End Sub
</lotusscript></code><code event='queryclose'><lotusscript>%REM
	Sub Queryclose
	Description: Runs before the database window closes; set Continue=False to cancel
%END REM
Sub Queryclose(Source As Notesuidatabase, Continue As Variant)
	Print "Default Database Script - closing"
End Sub
</lotusscript></code></databasescript>

