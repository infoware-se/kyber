<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE agent SYSTEM 'xmlschemas/domino_14_5_1.dtd'>
<agent name='Default-FormulaAgent' xmlns='http://www.lotus.com/dxl' version='14.5'
 maintenanceversion='1.0' hide='v3' publicaccess='false'
 designerversion='8.5.3'>



<trigger type='actionsmenu'/>
<documentset type='selected'/><code event='action'>
<simpleaction action='runformula'><formula>REM {newagentformula - Hello World};
@Prompt([Ok]; "newagentformula"; "Hello World");
SELECT @All</formula></simpleaction></code></agent>
