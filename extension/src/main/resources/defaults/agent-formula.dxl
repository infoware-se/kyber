<simpleaction action='runformula'><formula>REM {Default-FormulaAgent ΓÇö context prompt + stamp Status on selected docs};
@Prompt([Ok]; "Default-FormulaAgent";
	"Database: " + @DbTitle + @NewLine +
	"Server: " + @ServerName + @NewLine +
	"User: " + @UserName);
FIELD Status := @If(Status = ""; "Open"; Status);
SELECT @All</formula></simpleaction></code>
