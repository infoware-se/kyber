<wassignedby><name>CN=Designer/O=Infoware</name></wassignedby><code event='options'><lotusscript
>%REM
	Form Default-Form
	Description: Standalone form template - Options / Querysave / Postopen (no Use)
%END REM
Option Declare
</lotusscript></code><code event='postopen'><lotusscript>%REM
	Sub Postopen
	Description: After the form opens in the UI
%END REM
Sub Postopen(Source As Notesuidocument)
	Dim subject As String
	subject = Trim$(Source.FieldGetText("Subject"))
	If subject = "" Then subject = "(untitled)"
	Print "Default-Form opened: " &amp; subject
End Sub
</lotusscript></code><code event='querysave'><lotusscript>%REM
	Sub Querysave
	Description: Validate before save; set Continue=False to cancel
%END REM
Sub Querysave(Source As Notesuidocument, Continue As Variant)
	Dim subject As String
	subject = Source.FieldGetText("Subject")
	If Trim$(subject) = "" Then
		Messagebox "Subject is required", 0, "Default-Form"
		Continue = False
	End If
End Sub
</lotusscript></code>
