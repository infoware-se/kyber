 codepath='c:\Program Files\HCL\Notes\Data'><java name='JavaAgent.java'>import lotus.domino.*;

/**
 * Example Java agent (Default-JavaAgent).
 * Shows Session, Database and a simple document count.
 */
public class JavaAgent extends AgentBase {

	public void NotesMain() {
		try {
			Session session = getSession();
			AgentContext ctx = session.getAgentContext();
			Database db = ctx.getCurrentDatabase();
			System.out.println("Hello from " + session.getUserName());
			System.out.println("Database: " + db.getTitle());
			System.out.println("Documents: " + db.getAllDocuments().getCount());
		} catch (Exception e) {
			e.printStackTrace();
		}
	}
}
</java></javaproject></code>
