<wassignedby><name>CN=Designer/O=Infoware</name></wassignedby><code event='library'
 for='web'><javascript>/**
 * Client JS starter (Default-ClientJs)
 * Browser-side helpers for forms / pages.
 */

function hello(who) {
	who = who || 'World';
	return 'Hello, ' + who + '!';
}

function formatTitle(title) {
	if (!title || String(title).replace(/^\s+|\s+$/g, '') === '') {
		return '(untitled)';
	}
	return String(title).replace(/^\s+|\s+$/g, '');
}

/** Log a message to the browser console. */
function logMessage(msg) {
	if (typeof console !== 'undefined' &amp;&amp; console.log) {
		console.log('Default-ClientJs:', msg);
	}
	return msg;
}

function qs(sel) {
	return (typeof document !== 'undefined') ? document.querySelector(sel) : null;
}
</javascript></code>
